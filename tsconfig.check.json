// Specialized tsconfig for type-checking js files
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "ignoreDeprecations": "6.0"
    },
    "include": [
        "lib/**/*.js",
        "**/*.d.ts"
    ],
    "exclude": [
        "**/build",
        "**/*.test.js",
        "main.js",
        "node_modules/",
        "widgets/",
        "gulpfile.js"
    ]
}
