    },
    {
      "name": "twystd"
    }
  ],
  "homepage": "https://github.com/kBrausew/ioBroker.wiegand-tcpip",
  "license": "GPL-3.0-only",
  "keywords": [
    "ioBroker",
    "UHPPOTE",
    "Wiegand to TCP/IP",
    "VBESTLIFE",
    "Dioche",
    "Tangxi",
    "i-keys SC300xNT SC90xNT",
    "Secukey C1 - C4",
    "S4A ACB",
    "Door Access Controller Shenzhen Weigeng Industrial"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kBrausew/ioBroker.wiegand-tcpip.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "ipaddr.js": "^2.4.0",
    "uhppoted": "^0.9.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^7.1.8",
    "@types/gulp": "^4.0.18",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^10.0.20",
    "@types/sinon-chai": "^3.2.12",
    "axios": "^1.7.9",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "eslint": "^9.39.4",
    "gulp": "^4.0.2",
    "mocha": "^11.8.0",
    "proxyquire": "^2.1.3",
    "sinon": "^19.0.5",
    "sinon-chai": "^3.7.0",
    "typescript": "~6.0.3"
  },
  "main": "main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*).json",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "docs/",
    "lib/",
    "www/",
    "io-package.json",
    "package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "simulator:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-uhppote-simulator.ps1",
    "smoke:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-multicontroller-smoke.ps1",
    "smoke:multicontroller": "node ./scripts/smoke-multicontroller.js",
    "smoke:userops": "node ./scripts/smoke-userops-multicontroller.js",
    "smoke:stop": "npm run devlab:stop",
    "devlab:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-multicontroller-devlab.ps1",
    "devlab:stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-multicontroller-devlab.ps1",
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:unit": "mocha test/unit --exit",
    "test:integration": "mocha test/integration --exit",
    "test:regression": "mocha test/regression.simulator.js --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/kBrausew/ioBroker.wiegand-tcpip/issues"
  },
  "readmeFilename": "README.md"
}
